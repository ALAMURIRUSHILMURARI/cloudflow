# CloudFlow Frontend Environment Configuration
# Prepared for future AWS Serverless Integration

# Set to true to use client-side mock services (Default for prototype demonstration)
VITE_MOCK_MODE=true

# AWS API Gateway Base URL (e.g. https://api.cloudflow.enterprise.com/v1)
VITE_API_BASE_URL=https://mock-api.cloudflow.local/v1

# AWS Deployment Region
VITE_AWS_REGION=us-east-1

# Amazon Cognito User Pool Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_MockPool123
VITE_COGNITO_CLIENT_ID=mockclientappclientid987654

# Amazon S3 Bucket for Document & Receipt Uploads
VITE_S3_BUCKET=cloudflow-enterprise-attachments-dev
