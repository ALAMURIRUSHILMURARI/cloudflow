# Copy to prober.env and fill in. Never commit real passwords.
PRIMARY_URL=https://xxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
SECONDARY_URL=https://yyyyyyyy.execute-api.ap-southeast-2.amazonaws.com
# Cognito service user created by cloud/aws/create_users.sh (same user and password on both stacks).
COGNITO_USER=pi-edge-01
COGNITO_PASSWORD=change-me-1
# Only for stacks that still use the shared bearer token (local server, GCP).
API_TOKEN=
NODE_ID=pi-edge-01
LOG_DIR=/home/pi/edge-logs

# Load and failover tuning (defaults shown)
RATE_PER_MIN=60
CONCURRENCY=16
TIMEOUT_S=4
HEALTH_INTERVAL_S=2
FAILOVER_AFTER=3
FAILBACK_AFTER=5
REPORT_INTERVAL_S=60
KEEP_DAYS=7
