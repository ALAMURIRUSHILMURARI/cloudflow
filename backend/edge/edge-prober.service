[Unit]
Description=Serverless capstone edge prober (synthetic load + failover telemetry)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
User=pi
WorkingDirectory=/home/pi/capstone/edge
ExecStart=/usr/bin/python3 /home/pi/capstone/edge/prober.py --env-file /home/pi/capstone/edge/prober.env
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
