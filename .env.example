# CloudFlow Environment Template
# true = client-side mock services (localStorage). false = the live AWS backend in backend/.
VITE_MOCK_MODE=true

# API Gateway URLs printed by backend/cloud/aws/deploy_all.sh (primary and DR stack).
# Cognito settings are discovered from each stack's /health, so nothing else is needed.
VITE_API_BASE_URL=
VITE_API_SECONDARY_URL=
